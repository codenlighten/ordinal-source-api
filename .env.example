PORT=3000
HOST=0.0.0.0
NETWORK=main
RAW_TX_URL=https://api.whatsonchain.com/v1/bsv/{network}/tx/{txid}/hex
RAW_TX_TIMEOUT_MS=15000
CACHE_MAX=500
CACHE_TTL_MS=600000
MAX_INLINE_CONTENT_BYTES=262144
MAX_ENVELOPES_PER_OUTPUT=16
# 0 = unlimited; inscriptions may legitimately be video-sized
MAX_TX_BYTES=0
CACHE_MAX_TX_BYTES=2097152
MAX_CONCURRENT_FETCHES=6
MAX_BODY_BYTES=134217728
RATE_LIMIT=on
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=30
TRUST_PROXY=false
VERIFY_MAX_HOPS=32
VERIFY_MAX_FETCHES=120
LOG_LEVEL=info
LOG_FORMAT=json
SHUTDOWN_GRACE_MS=15000
